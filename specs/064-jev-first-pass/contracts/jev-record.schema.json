{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parallax/064/jev-record",
  "title": "Jev record (064)",
  "description": "One Jev request, or one excluded research claim, recorded beside the big model's label for the same item. Bound to the jev_records table columns by a two-way test.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "server_session_id",
    "site",
    "mode",
    "questions_json",
    "model_requested",
    "outcome",
    "applied",
    "redaction_count",
    "truncated"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "server_session_id": { "type": "string" },
    "harness_session_id": { "type": ["string", "null"] },
    "site": { "enum": ["turn_review", "research_claims", "research_injection", "tool_risk", "turn_signals"] },
    "mode": { "enum": ["shadow", "on"] },
    "questions_json": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "option_order"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "option_order": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": ["string", "number", "null"] },
          "probabilities": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "band": { "enum": ["yes", "middle", "no", null] },
          "recommends": { "description": "Turn signals (068): the corrective 066's rule names for this signal given the catalog at the time.", "enum": ["verify", "grounded_verify", "research", null] },
          "number_diff": { "description": "Turn signals (068), pushback_reversal only: a number or date in the final text differs from one in a transcript pair's earlier statement.", "type": ["boolean", "null"] },
          "excluded_claims": { "description": "Turn signals (068), unverified_fact only: how many claims with numbers or dates were taken out of the final text before sending.", "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "model_requested": { "type": "string" },
    "model_answered": { "type": ["string", "null"] },
    "outcome": {
      "description": "One of the published outcome list (invocation-record.schema.json), or excluded.",
      "type": "string"
    },
    "error_class": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "applied": { "const": false },
    "eval_id": { "type": ["string", "null"] },
    "invocation_id": { "type": ["string", "null"] },
    "claim_key": { "type": ["string", "null"] },
    "source_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "label_json": {
      "oneOf": [
        { "type": "null" },
        {
          "description": "Turn review. contradicts, violates and capture_kind are the review model's raw answers; contradiction_flagged, violation_flagged and captured record what the review did (flags raised, capture stored), which plan 7.1 counts. Labels written before 2026-11-25 lack the outcome fields; the back-test report treats them as unlabeled.",
          "type": "object",
          "additionalProperties": false,
          "required": ["violates"],
          "properties": {
            "contradicts": { "type": ["boolean", "null"] },
            "violates": { "type": "boolean" },
            "capture_kind": { "enum": ["skill", "lesson", "none", null] },
            "contradiction_flagged": { "type": ["boolean", "null"] },
            "violation_flagged": { "type": "boolean" },
            "captured": { "type": ["boolean", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["support", "votes_supported", "votes_refuted", "votes_completed", "sources"],
          "properties": {
            "support": { "enum": ["confirmed", "unverified", "contested", "refuted"] },
            "votes_supported": { "type": "integer", "minimum": 0 },
            "votes_refuted": { "type": "integer", "minimum": 0 },
            "votes_completed": { "type": "integer", "minimum": 0 },
            "sources": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "description": "Tool risk (067): the big model's action_class answer for the same redacted projection Jev saw; label_source names the model and prompt version. Null on excluded rows.",
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "properties": {
            "class": { "enum": ["spend_or_destructive", "state_changing", "read_only"] }
          }
        }
      ]
    },
    "label_source": { "type": ["string", "null"] },
    "cooldown_suppressed": { "description": "Turn signals (068): the signal kinds whose yes answer would have been suppressed by the cooldown (session plus kind); null on other sites.", "type": ["array", "null"], "items": { "type": "string" } },
    "label_cost_usd": { "description": "Tool risk (067): the label call's cost; null where no label call was made.", "type": ["number", "null"], "minimum": 0 },
    "state_json": { "description": "Research only: the redacted state sent, for replay.", "type": ["object", "null"] },
    "state_hash": { "type": ["string", "null"] },
    "transcript_ref": { "type": ["string", "null"] },
    "redaction_count": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
  }
}
